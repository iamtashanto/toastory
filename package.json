{
  "name": "glazekit",
  "version": "0.1.0",
  "description": "Complete UI feedback toolkit: toast notifications, confirm / prompt / alert dialogs, sheets and loading overlays with frosted glass design.",
  "license": "MIT",
  "author": "TA Shanto <shanto@glazekit.dev>",
  "homepage": "https://glazekit.dev",
  "bugs": {
    "url": "https://github.com/iamtashanto/glazekit/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "toast",
    "notification",
    "snackbar",
    "dialog",
    "modal",
    "confirm",
    "prompt",
    "alert",
    "sweetalert",
    "glassmorphism",
    "ios",
    "liquid-glass",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "angular",
    "svelte",
    "react-native",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamtashanto/glazekit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "native": [
        "./dist/native.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    },
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "node scripts/contrast.ts",
    "docs:tokens": "node scripts/generate-tokens-doc.ts",
    "build": "tsup && node scripts/build-themes.mjs",
    "size": "node scripts/size.mjs",
    "readme:check": "node scripts/check-readme.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run contrast && npm run build && npm run size && npm run readme:check",
    "check:all": "npm run check && npm run test:e2e",
    "changeset": "changeset",
    "release": "npm run check && changeset publish"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "dompurify": ">=3",
    "expo-blur": ">=12",
    "expo-haptics": ">=12",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@angular/core": "^21.2.25",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native": "^0.72.8",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "zone.js": "^0.16.3"
  }
}
